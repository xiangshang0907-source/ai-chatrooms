# =============================================================================
# AI Chatrooms 环境变量配置示例
# =============================================================================
# 
# 使用说明：
# 1. 复制此文件为 .env：cp .env.example .env
# 2. 编辑 .env 文件，填入实际的值
# 3. 重要：请使用强密码，不要使用默认值
# 4. 此文件包含敏感信息，不要提交到版本控制
#
# 生成强密码命令：
# python -c "import secrets; print('SECRET_KEY=' + secrets.token_urlsafe(32))"
# python -c "import secrets; print('JWT_SECRET_KEY=' + secrets.token_urlsafe(32))"
# python -c "import secrets; print('POSTGRES_PASSWORD=' + secrets.token_urlsafe(16))"
# =============================================================================

# =============================================================================
# Flask 应用配置
# =============================================================================
FLASK_ENV=development
FLASK_DEBUG=0
PORT=8000

# =============================================================================
# 应用密钥配置 - 必须修改为强密码
# =============================================================================
# 应用主密钥 - 用于会话加密等
SECRET_KEY=your-super-secret-key-here-change-this-immediately
# JWT 令牌密钥 - 用于用户认证
JWT_SECRET_KEY=your-jwt-secret-key-here-change-this-immediately

# =============================================================================
# 数据库配置 (Docker Compose 使用)
# =============================================================================
# PostgreSQL 用户名
POSTGRES_USER=ai_chatrooms_user
# PostgreSQL 密码 - 必须使用强密码
POSTGRES_PASSWORD=your_strong_database_password_here
# PostgreSQL 数据库名
POSTGRES_DB=ai_chatrooms

# =============================================================================
# 数据库连接配置 (本地开发)
# =============================================================================
# 推荐：仅设置 POSTGRES_*，由应用自动构建 DATABASE_URL
# 如需覆盖，取消下一行注释并保持与 POSTGRES_* 一致
# DATABASE_URL=postgresql://ai_chatrooms_user:your_strong_database_password_here@localhost:5432/ai_chatrooms

# Redis 连接字符串
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# JWT 令牌配置
# =============================================================================
# 访问令牌过期时间（秒）
JWT_ACCESS_TOKEN_EXPIRES=3600
# 刷新令牌过期时间（秒）
JWT_REFRESH_TOKEN_EXPIRES=2592000

# =============================================================================
# LLM 提供商配置
# =============================================================================
# 默认 LLM 提供商 (qwen, openai, azure, aws)
DEFAULT_LLM_PROVIDER=qwen

# =============================================================================
# 千问（百炼）配置
# =============================================================================
# 千问 API 密钥 - 从阿里云获取
QWEN_API_KEY=sk-your-qwen-api-key-here
# 千问 API 基础 URL
QWEN_API_BASE=https://dashscope.aliyuncs.com/api/v1

# =============================================================================
# OpenAI 配置
# =============================================================================
# OpenAI API 密钥 - 从 OpenAI 获取
OPENAI_API_KEY=sk-your-openai-api-key-here
# OpenAI API 基础 URL
OPENAI_API_BASE=https://api.openai.com/v1

# =============================================================================
# Azure OpenAI 配置
# =============================================================================
# Azure OpenAI API 密钥
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
# Azure OpenAI 端点
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# Azure OpenAI API 版本
AZURE_OPENAI_API_VERSION=2023-12-01-preview

# =============================================================================
# AWS 配置
# =============================================================================
# AWS 区域
AWS_REGION=ap-southeast-1
# AWS 访问密钥 ID
AWS_ACCESS_KEY_ID=your-aws-access-key-id-here
# AWS 秘密访问密钥
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key-here

# =============================================================================
# 生产环境额外配置（可选）
# =============================================================================
# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
# 是否启用 CORS
CORS_ENABLED=true
# 允许的 CORS 源
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# 数据库连接池大小
DB_POOL_SIZE=10
# 数据库连接超时（秒）
DB_CONNECT_TIMEOUT=30
